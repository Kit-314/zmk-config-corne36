#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        dot_comma: dot_comma {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COMMA>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        /* Mouse layer entry: set LED colour to red AND toggle layer 3 on.
         * Red is the visual indicator that mouse mode is active. */
        mouse_enter: mouse_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(0,100,20)>, <&tog 3>;
        };
        /* Mouse layer exit: restore default white LED colour AND toggle
         * layer 3 off. Loses any custom colour you'd previously set
         * (e.g. blue preset) — re-press the colour preset key after exit
         * if you want that back. */
        mouse_exit: mouse_exit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(0,0,20)>, <&tog 3>;
        };
    };

    combos {
        compatible = "zmk,combos";
        BtClr {
            bindings = <&bt BT_CLR>;
            key-positions = <1 2 3 4 5>;
            timeout-ms = <60>;
            layers = <2>;
        };
        BtSel0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <1 2 3>;
            timeout-ms = <60>;
            layers = <2>;
        };
        BtSel1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <13 14 15>;
            timeout-ms = <60>;
            layers = <2>;
        };
        BtSel2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <25 26 27>;
            timeout-ms = <60>;
            layers = <2>;
        };
        Bootloader {
            bindings = <&bootloader>;
            key-positions = <31 32 33 34>;
            timeout-ms = <60>;
            layers = <2>;
        };
        VolUp {
            /* Outermost three keys on top row of right half: I, O, P */
            bindings = <&kp C_VOL_UP>;
            key-positions = <8 9 10>;
            timeout-ms = <100>;
            layers = <0>;
        };
        VolDn {
            /* Outermost three keys on middle row of right half: K, L, BSPC */
            bindings = <&kp C_VOL_DN>;
            key-positions = <20 21 22>;
            timeout-ms = <100>;
            layers = <0>;
        };
        MissionControl {
            /* N + M + ' on right half bottom row → Ctrl+Up (macOS Mission Control) */
            bindings = <&kp LC(UP)>;
            key-positions = <30 31 32>;
            timeout-ms = <100>;
            layers = <0>;
        };
        MouseEnter {
            /* D + F + G on left half home row, when on layer 0 →
             * enter mouse layer + change LED colour to red. */
            bindings = <&mouse_enter>;
            key-positions = <15 16 17>;
            timeout-ms = <100>;
            layers = <0>;
        };
        MouseExit {
            /* D + F + G on left half home row, when on layer 3 →
             * exit mouse layer + restore default LED colour.
             * Note: D/F/G on layer 3 are MOVE_LEFT/MOVE_DOWN/MOVE_RIGHT,
             * so pressing them all together within 100ms fires this combo
             * (exits the layer) rather than the three movement bindings. */
            bindings = <&mouse_exit>;
            key-positions = <15 16 17>;
            timeout-ms = <100>;
            layers = <3>;
        };
        /* No EP_TOG combo. EXT_POWER powers both the displays and the LEDs
         * on this PCB, so the only sane state is "always on". Combined with
         * CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER=n in corne.conf, nothing in
         * the firmware can disable EXT_POWER any more — it can't get stuck
         * off and brick the keyboard. */
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            label = "DEFAULT";
            bindings = <
&trans  &kp Q  &kp W  &kp E       &kp R  &kp T       &kp Y      &kp U  &kp I     &kp O    &kp P          &trans
&trans  &kp A  &kp S  &kp D       &kp F  &kp G       &kp H      &kp J  &kp K     &kp L    &kp BACKSPACE  &trans
&trans  &kp Z  &kp X  &kp C       &kp V  &kp B       &kp N      &kp M  &kp APOS  &dot_comma  &kp ENTER      &trans
                       &kp LCTL    &mo 1  &kp LSHFT   &kp SPACE  &mo 2  &kp LGUI
            >;
        };
        upper_layer {
            label = "UPPER";
            bindings = <
&trans  &kp N7  &kp N8  &kp N9  &kp N0  &kp PG_UP    &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT         &kp TAB   &trans
&trans  &kp N4  &kp N5  &kp N6  &trans  &kp PG_DN    &kp ESC    &kp DQT    &kp GRAVE         &kp LS(NUMBER_3) &kp AT    &trans
&trans  &kp N1  &kp N2  &kp N3  &trans  &kp F11      &kp BSLH   &kp PIPE   &kp TILDE         &kp NON_US_HASH  &kp LALT  &trans
                         &trans  &mo 1  &trans       &trans     &mo 2      &trans
            >;
        };
        lower_layer {
            label = "LOWER";
            bindings = <
&trans  &kp BANG   &kp AT    &kp HASH  &kp DLLR                        &kp PRCT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR   &trans
&trans  &kp COLN   &kp QMARK &kp FSLH  &kp SCLN                        &kp UNDER   &kp MINUS  &kp EQUAL  &kp LBRC   &kp RBRC  &kp BSPC   &trans
&trans  &kp LSHFT  &kp PLUS  &kp LBKT  &rgb_ug RGB_COLOR_HSB(0,0,15)   &rgb_ug RGB_COLOR_HSB(170,100,15)    &kp UNDER  &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &trans
                              &rgb_ug RGB_TOG  &mo 1  &kp LCTL    &kp SPACE  &mo 2      &kp RSFT
            >;
        };
        mouse_layer {
            /* Layer 3 — entered/exited via D+F+G combo (sticky toggle).
             * Movement: R(up), D(left), F(down), G(right). Combine two for diagonals.
             * Clicks: Y = left click, U = right click.
             * Scroll modifier: hold I → layer 6 (R/D/F/G become scroll directions).
             * Speed modifiers: hold inner-right thumb → fast (layer 4),
             *                  hold middle-right thumb → slow (layer 5).
             * Everything else &trans so you can still type/modify mid-mouse. */
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &mmv MOVE_UP    &trans          &mkp LCLK       &mkp RCLK       &mo 6           &trans          &trans          &trans
&trans  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans          &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans  &trans  &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                        &trans  &trans  &trans          &mo 4   &mo 5   &trans
            >;
        };
        fast_layer {
            /* Layer 4 — held via inner-right thumb on mouse layer.
             * Overrides R/D/F/G with 3× movement speed (1800 vs default 600). */
            label = "FAST";
            bindings = <
&trans  &trans  &trans  &trans  &mmv MOVE(0,-1800)  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &mmv MOVE(-1800,0)  &mmv MOVE(0,1800)  &mmv MOVE(1800,0)  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
        slow_layer {
            /* Layer 5 — held via middle-right thumb on mouse layer.
             * Overrides R/D/F/G with 1/3× movement speed (200 vs default 600). */
            label = "SLOW";
            bindings = <
&trans  &trans  &trans  &trans  &mmv MOVE(0,-200)  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &mmv MOVE(-200,0)  &mmv MOVE(0,200)  &mmv MOVE(200,0)  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
        scroll_layer {
            /* Layer 6 — held via I on mouse layer.
             * Overrides R/D/F/G with scroll directions instead of movement.
             * Highest-numbered of the mouse modifier layers, so it wins if
             * combined with fast/slow (scroll always plays at normal speed).
             *
             * Up/down are inverted vs. movement because macOS "natural
             * scrolling" treats content motion as the primary direction:
             * R (up arrow) → SCRL_DOWN sends content upward (user perceives
             * as scrolling up); F (down arrow) → SCRL_UP sends content
             * downward (user perceives as scrolling down). */
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &msc SCRL_DOWN  &trans          &trans          &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_RIGHT  &trans          &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans  &trans  &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                        &trans  &trans  &trans          &trans  &trans  &trans
            >;
        };
    };
};

// LED chain-length override must live here (in the keymap, which is the last
// overlay applied) because ZMK's cmake processes user config overlays BEFORE
// the shield board overlay that defines the led_strip node.
&led_strip {
    chain-length = <24>; /* 18 per-key SK6812 MINI-E + 6 underglow — underglow is mid-chain so can't exclude */
};
