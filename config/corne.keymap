#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * OS SWITCHING: BT profile 0 (QWE combo) and 1 (ASD) are Mac hosts; profile 2
 * (ZXC) is the Linux PC. The BtSel combos bind macros that select the profile
 * AND switch base layer in one press. Layer 1 (LINUX) is a near-transparent
 * marker base; ZMK combos match against the highest active layer, so combos
 * scoped to 0 are Mac-only and combos scoped to 1 are Linux-only. The Linux
 * lower layer (8) exists so lower-layer combos can be OS-scoped the same way.
 * The OS base layer also self-heals across power cycles: src/os_profile_layer.c
 * (central-only listener) derives it from the active BLE profile on every
 * profile change AND ~2s after boot, so switching off to charge while bonded
 * to the Linux box comes back in Linux mode automatically. The &to in the
 * BtSel macros below gives the same result instantly at press time.
 *
 * Layer index map:
 *   0 DEFAULT (Mac base)   1 LINUX (Linux base)   2 UPPER   3 LOWER (Mac)
 *   4 MOUSE   5 FAST   6 SLOW   7 SCROLL   8 LOWER_LX (Linux lower)
 */

/ {
    behaviors {
        dot_comma: dot_comma {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COMMA>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        gt_lt: gt_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp GT>, <&kp LT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        /* Mouse layer entry: set LED colour to green AND toggle layer 4 on.
         * Green is the visual indicator that mouse mode is active. */
        mouse_enter: mouse_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(120,100,20)>, <&tog 4>;
        };
        /* Mouse layer exit: restore default white LED colour AND toggle
         * layer 4 off. Loses any custom colour you'd previously set
         * (e.g. blue preset) — re-press the colour preset key after exit
         * if you want that back. */
        mouse_exit: mouse_exit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(0,0,20)>, <&tog 4>;
        };
        /* Host select = BT profile + matching OS base layer, one press.
         * &to enables the target base and disables all other layers except
         * the always-on default (0), so the two bases can never stack. */
        sel_mac0: sel_mac0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to 0>;
        };
        sel_mac1: sel_mac1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to 0>;
        };
        sel_lx2: sel_lx2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&to 1>;
        };
    };

    combos {
        compatible = "zmk,combos";
        /* Bluetooth (LOWER layers, both OS modes). Each BtSel also switches
         * the OS base layer: QWE/ASD = Mac hosts, ZXC = Linux PC. */
        BtClr {
            bindings = <&bt BT_CLR>;
            key-positions = <1 2 3 4 5>;
            timeout-ms = <60>;
            layers = <3 8>;
        };
        BtSel0 {
            bindings = <&sel_mac0>;
            key-positions = <1 2 3>;
            timeout-ms = <60>;
            layers = <3 8>;
        };
        BtSel1 {
            bindings = <&sel_mac1>;
            key-positions = <13 14 15>;
            timeout-ms = <60>;
            layers = <3 8>;
        };
        BtSel2 {
            bindings = <&sel_lx2>;
            key-positions = <25 26 27>;
            timeout-ms = <60>;
            layers = <3 8>;
        };
        Bootloader {
            bindings = <&bootloader>;
            key-positions = <31 32 33 34>;
            timeout-ms = <60>;
            layers = <3 8>;
        };
        Copy {
            /* Y + U + I on right half top row → Cmd+C (copy), Mac lower only */
            bindings = <&kp LG(C)>;
            key-positions = <6 7 8>;
            timeout-ms = <60>;
            layers = <3>;
        };
        Paste {
            /* H + J + K on right half home row → Cmd+V (paste), Mac lower only */
            bindings = <&kp LG(V)>;
            key-positions = <18 19 20>;
            timeout-ms = <60>;
            layers = <3>;
        };
        CopyLx {
            /* Linux twin of Copy → Ctrl+C */
            bindings = <&kp LC(C)>;
            key-positions = <6 7 8>;
            timeout-ms = <60>;
            layers = <8>;
        };
        PasteLx {
            /* Linux twin of Paste → Ctrl+V */
            bindings = <&kp LC(V)>;
            key-positions = <18 19 20>;
            timeout-ms = <60>;
            layers = <8>;
        };
        VolUp {
            /* Outermost three keys on top row of right half: I, O, P.
             * Consumer codes — OS-agnostic, active on both bases. */
            bindings = <&kp C_VOL_UP>;
            key-positions = <8 9 10>;
            timeout-ms = <100>;
            layers = <0 1>;
        };
        VolDn {
            /* Outermost three keys on middle row of right half: K, L, BSPC */
            bindings = <&kp C_VOL_DN>;
            key-positions = <20 21 22>;
            timeout-ms = <100>;
            layers = <0 1>;
        };
        MissionControl {
            /* N + M + ' on right half bottom row → Ctrl+Up (macOS Mission Control) */
            bindings = <&kp LC(UP)>;
            key-positions = <30 31 32>;
            timeout-ms = <100>;
            layers = <0>;
        };
        MissionCtrlLx {
            /* Linux twin → Super tap = GNOME Activities overview; adjust for other DEs */
            bindings = <&kp LGUI>;
            key-positions = <30 31 32>;
            timeout-ms = <100>;
            layers = <1>;
        };
        Screenshot {
            /* Y + U + I on right half top row → Shift+Cmd+4 (macOS area screenshot) */
            bindings = <&kp LS(LG(N4))>;
            key-positions = <6 7 8>;
            timeout-ms = <100>;
            layers = <0>;
        };
        ScreenshotLx {
            /* Linux twin → PrintScreen = screenshot UI on GNOME/KDE */
            bindings = <&kp PSCRN>;
            key-positions = <6 7 8>;
            timeout-ms = <100>;
            layers = <1>;
        };
        MouseEnter {
            /* D + F + G on left half home row, when on either base →
             * enter mouse layer + change LED colour to green. */
            bindings = <&mouse_enter>;
            key-positions = <15 16 17>;
            timeout-ms = <100>;
            layers = <0 1>;
        };
        MouseExit {
            /* D + F + G on left half home row, when on layer 4 (MOUSE) →
             * exit mouse layer + restore default LED colour.
             * Note: D/F/G on the mouse layer are MOVE_LEFT/MOVE_DOWN/MOVE_RIGHT,
             * so pressing them all together within 100ms fires this combo
             * (exits the layer) rather than the three movement bindings. */
            bindings = <&mouse_exit>;
            key-positions = <15 16 17>;
            timeout-ms = <100>;
            layers = <4>;
        };
        /* Scroll combos on the base layers — scroll without entering the
         * mouse layer. The scroll layer (layer 7, reached via I on the
         * mouse layer) is still in place for horizontal scroll and as a
         * fallback for when you're already in mouse mode.
         * These repurpose two combos that became vestigial after the
         * Mouseless pivot: Q+W+E was Homerow click-hints (F13), A+S+D was
         * Homerow scroll (F16). Mouseless activates via LeftCmd-tap natively,
         * so the F-key combos had nothing listening for them.
         * NOTE on direction with macOS natural scrolling enabled: to scroll
         * UP (perceived), emit SCRL_DOWN (sends content upward); to scroll
         * DOWN (perceived), emit SCRL_UP. The combo names below describe
         * user-perceived direction; the binding emits the inverted keycode.
         * 3-key combos (like the other base-layer combos) so they don't
         * misfire mid-word. Left hand: right-hand triples are already taken. */
        ScrollUp {
            /* Q + W + E (top-left) → scroll UP (top row = up direction). */
            bindings = <&msc SCRL_DOWN>;
            key-positions = <1 2 3>;
            timeout-ms = <100>;
            layers = <0 1>;
        };
        ScrollDown {
            /* A + S + D (home-left) → scroll DOWN. */
            bindings = <&msc SCRL_UP>;
            key-positions = <13 14 15>;
            timeout-ms = <100>;
            layers = <0 1>;
        };
        /* Mouseless "toggle continuous mode" trigger. F17 = reserved private
         * namespace (no physical Mac F17, no default macOS binding) — emitted
         * only by this combo. Bind F17 in Mouseless's config editor to
         * "Toggle continuous mode until closed".
         * Usage: tap LeftCmd to open overlay, press Z+X+C to enter sticky
         * mode, click through things, Esc to dismiss (auto-disables sticky).
         * Z+X+C completes the left-hand row pattern: top=scroll up,
         * home=scroll down, bottom=sticky.
         * Mouseless is a Mac app — Mac base only. */
        MouselessSticky {
            /* Z + X + C (bottom-left) → F17 = Mouseless continuous-mode toggle */
            bindings = <&kp F17>;
            key-positions = <25 26 27>;
            timeout-ms = <100>;
            layers = <0>;
        };
        /* No EP_TOG combo. EXT_POWER powers both the displays and the LEDs
         * on this PCB, so the only sane state is "always on". Combined with
         * CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER=n in corne.conf, nothing in
         * the firmware can disable EXT_POWER any more — it can't get stuck
         * off and brick the keyboard. */
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            label = "DEFAULT";
            bindings = <
&trans  &kp Q  &kp W  &kp E       &kp R  &kp T       &kp Y      &kp U  &kp I     &kp O    &kp P          &trans
&trans  &kp A  &kp S  &kp D       &kp F  &kp G       &kp H      &kp J  &kp K     &kp L    &kp BACKSPACE  &trans
&trans  &kp Z  &kp X  &kp C       &kp V  &kp B       &kp N      &kp M  &kp APOS  &dot_comma  &kp ENTER      &trans
                       &kp LCTL    &mo 2  &kp LSHFT   &kp SPACE  &mo 3  &kp LGUI
            >;
        };
        linux_layer {
            /* Linux base marker. Everything falls through to DEFAULT except
             * the lower-layer thumb, which opens the Linux lower layer so
             * lower-layer combos resolve to their Linux variants. */
            label = "LINUX";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans      &trans  &mo 8   &trans
            >;
        };
        upper_layer {
            label = "UPPER";
            bindings = <
&trans  &kp N7  &kp N8  &kp N9  &kp N0  &kp PG_UP    &gt_lt     &kp PRCNT     &kp LBKT         &kp RBKT         &kp TAB   &trans
&trans  &kp N4  &kp N5  &kp N6  &kp PLUS   &kp PG_DN    &kp ESC    &kp DQT    &kp GRAVE         &kp LS(NUMBER_3) &kp AT    &trans
&trans  &kp N1  &kp N2  &kp N3  &kp EQUAL  &kp F11      &kp BSLH   &kp PIPE   &kp TILDE         &kp NON_US_HASH  &kp LALT  &trans
                         &trans  &mo 2  &trans       &trans     &trans     &trans
            >;
        };
        lower_layer {
            label = "LOWER";
            bindings = <
&trans  &kp BANG   &kp AT    &kp HASH  &kp DLLR                        &kp PRCT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR   &trans
&trans  &kp COLN   &kp QMARK &kp FSLH  &kp SCLN                        &kp UNDER   &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT &kp BSPC   &trans
&trans  &kp LSHFT  &kp PLUS  &kp LBKT  &rgb_ug RGB_COLOR_HSB(0,0,15)   &rgb_ug RGB_COLOR_HSB(170,100,15)    &kp UNDER  &kp MINUS  &kp EQUAL  &kp LBRC  &kp RBRC  &trans
                              &rgb_ug RGB_TOG  &mo 2  &kp LCTL    &kp SPACE  &mo 3      &kp RSFT
            >;
        };
        mouse_layer {
            /* Layer 4 — entered/exited via D+F+G combo (sticky toggle).
             * Movement: R(up), D(left), F(down), G(right). Combine two for diagonals.
             * Default velocity 1400 (set explicitly per-binding; the bare
             * MOVE_UP/etc. macros use ZMK's 600 default from pointing.h,
             * which is a #define and not Kconfig-overridable).
             * Clicks: Y = left click, U = right click.
             * Scroll modifier: hold I → layer 7 (R/D/F/G become scroll directions).
             * Speed modifiers: hold inner-right thumb → fast (layer 5),
             *                  hold middle-right thumb → slow (layer 6).
             * Everything else &trans so you can still type/modify mid-mouse. */
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &mmv MOVE(0,-1400)    &trans          &mkp LCLK       &mkp RCLK       &mo 7           &trans          &trans          &trans
&trans  &trans  &trans  &mmv MOVE(-1400,0)  &mmv MOVE(0,1400)  &mmv MOVE(1400,0)  &trans          &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans  &trans  &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                        &trans  &trans  &trans          &mo 5   &mo 6   &trans
            >;
        };
        fast_layer {
            /* Layer 5 — held via inner-right thumb on mouse layer.
             * Overrides R/D/F/G with 3× movement speed (1800 vs default 600). */
            label = "FAST";
            bindings = <
&trans  &trans  &trans  &trans  &mmv MOVE(0,-1800)  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &mmv MOVE(-1800,0)  &mmv MOVE(0,1800)  &mmv MOVE(1800,0)  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
        slow_layer {
            /* Layer 6 — held via middle-right thumb on mouse layer.
             * Overrides R/D/F/G with 1/3× movement speed (200 vs default 600). */
            label = "SLOW";
            bindings = <
&trans  &trans  &trans  &trans  &mmv MOVE(0,-200)  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &mmv MOVE(-200,0)  &mmv MOVE(0,200)  &mmv MOVE(200,0)  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
        scroll_layer {
            /* Layer 7 — held via I on mouse layer.
             * Overrides R/D/F/G with scroll directions instead of movement.
             * Highest-numbered of the mouse modifier layers, so it wins if
             * combined with fast/slow (scroll always plays at normal speed).
             *
             * Up/down are inverted vs. movement because macOS "natural
             * scrolling" treats content motion as the primary direction:
             * R (up arrow) → SCRL_DOWN sends content upward (user perceives
             * as scrolling up); F (down arrow) → SCRL_UP sends content
             * downward (user perceives as scrolling down). */
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &msc SCRL_DOWN  &trans          &trans          &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_RIGHT  &trans          &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans  &trans  &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
                        &trans  &trans  &trans          &trans  &trans  &trans
            >;
        };
        lower_lx_layer {
            /* Layer 8 — byte-for-byte clone of LOWER — exists only so the
             * lower-layer combos (BT, copy/paste) can tell the two OS modes
             * apart. Reached via the lower thumb while the LINUX base is on. */
            label = "LOWER_LX";
            bindings = <
&trans  &kp BANG   &kp AT    &kp HASH  &kp DLLR                        &kp PRCT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR   &trans
&trans  &kp COLN   &kp QMARK &kp FSLH  &kp SCLN                        &kp UNDER   &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT &kp BSPC   &trans
&trans  &kp LSHFT  &kp PLUS  &kp LBKT  &rgb_ug RGB_COLOR_HSB(0,0,15)   &rgb_ug RGB_COLOR_HSB(170,100,15)    &kp UNDER  &kp MINUS  &kp EQUAL  &kp LBRC  &kp RBRC  &trans
                              &rgb_ug RGB_TOG  &mo 2  &kp LCTL    &kp SPACE  &mo 8      &kp RSFT
            >;
        };
    };
};

// LED chain-length override must live here (in the keymap, which is the last
// overlay applied) because ZMK's cmake processes user config overlays BEFORE
// the shield board overlay that defines the led_strip node.
&led_strip {
    chain-length = <24>; /* 18 per-key SK6812 MINI-E + 6 underglow — underglow is mid-chain so can't exclude */
};
