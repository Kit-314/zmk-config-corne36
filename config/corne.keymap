#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt { tapping_term_ms = <200>; };

/ {
    key_overrides {
        compatible = "zmk,key-overrides";
        
        dot_comma: dot_comma {
            bindings = <&kp COMMA>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            key-position = <33>;
            layers = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";
        Enter {
            bindings = <&kp ENTER>;
            key-positions = <18 19 20>;
            timeout-ms = <60>;
            require-prior-idle-ms = <1>;
        };
        BtClr {
            bindings = <&bt BT_CLR>;
            key-positions = <1 2 3 4 5>;
            timeout-ms = <60>;
            layers = <2>;
        };
        BtSel0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <1 2 3>;
            timeout-ms = <60>;
            layers = <2>;
        };
        BtSel1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <13 14 15>;
            timeout-ms = <60>;
            layers = <2>;
        };
        BtSel2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <25 26 27>;
            timeout-ms = <60>;
            layers = <2>;
        };
        Bootloader {
            bindings = <&bootloader>;
            key-positions = <31 32 33 34>;
            timeout-ms = <60>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
&trans  &kp Q  &kp W  &kp E      &kp R  &kp T       &kp Y      &kp U  &kp I     &kp O    &kp P          &trans
&trans  &kp A  &kp S  &kp D      &kp F  &kp G       &kp H      &kp J  &kp K     &kp L    &kp LALT       &trans
&trans  &kp Z  &kp X  &kp C      &kp V  &kp B       &kp N      &kp M  &kp APOS  &kp DOT  &kp BACKSPACE  &trans
                       &kp LCTL   &mo 1  &sk LSHFT   &kp SPACE  &mo 2  &kp LGUI
            >;
        };
        upper_layer {
            bindings = <
&trans  &kp N7  &kp N8  &kp N9  &kp N0  &kp PG_UP    &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT         &kp TAB  &trans
&trans  &kp N4  &kp N5  &kp N6  &trans  &kp PG_DN    &kp ESC    &kp DQT    &kp GRAVE         &kp LS(NUMBER_3) &kp AT   &trans
&trans  &kp N1  &kp N2  &kp N3  &trans  &kp F11      &kp BSLH   &kp PIPE   &kp TILDE         &kp NON_US_HASH  &trans   &trans
                         &trans  &mo 1  &trans       &trans     &mo 2      &trans
            >;
        };
        lower_layer {
            bindings = <
&trans  &kp BANG   &kp AT    &kp HASH  &kp DLLR  &kp PRCT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR   &trans
&trans  &kp COLN   &kp QMARK &kp FSLH  &kp SCLN  &kp UNDER   &kp MINUS  &kp EQUAL  &kp LBRC   &kp RBRC  &kp BSPC   &trans
&trans  &kp LSHFT  &kp PLUS  &kp LBKT  &kp RBKT  &kp BSLH    &kp UNDER  &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &trans
                              &kp RSFT  &mo 1     &kp LCTL    &kp SPACE  &mo 2      &kp RSFT
            >;
        };
    };
};
