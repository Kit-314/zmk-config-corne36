#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt { tapping_term_ms = <200>; };

/ {
    key_overrides {
        compatible = "zmk,key-overrides";
        
        dot_comma: dot_comma {
            bindings = <&kp COMMA>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            key-position = <33>;
        };
        
        question_bracket: question_bracket {
            bindings = <&kp LPAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            key-position = <22>;
        };
    };

    combos {
        compatible = "zmk,combos";
        Enter {
            bindings = <&kp ENTER>;
            key-positions = <18 19 20>;
            timeout-ms = <60>;
            require-prior-idle-ms = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
&trans  &kp Q       &kp W  &kp E      &kp R  &kp T       &kp Y      &kp U  &kp I     &kp O    &kp P               &trans
&trans  &kp A       &kp S  &kp D      &kp F  &kp G       &kp H      &kp J  &kp K     &kp L    &kp QUESTION        &trans
&trans  &mt LSFT Z  &kp X  &kp C      &kp V  &kp B       &kp N      &kp M  &kp APOS  &kp DOT  &mt LSFT BACKSPACE  &trans
                           &sk LSHFT  &mo 1  &kp LCTL    &kp SPACE  &mo 2  &kp BSPC
            >;
        };
        upper_layer {
            bindings = <
&trans  &kp N7  &kp N8  &kp N9  &kp N0   &trans    &kp MINUS  &kp EQUAL  &kp LBKT       &kp RBKT        &trans   &trans
&trans  &kp N4  &kp N5  &kp N6  &trans   &trans    &kp ESC    &kp DQT    &kp GRAVE      &kp LS(N3)      &kp AT   &trans
&trans  &kp N1  &kp N2  &kp N3  &trans   &trans    &kp BSLH   &kp PIPE   &kp TILDE      &kp NON_US_HASH &trans   &trans
                         &trans  &mo 1   &trans    &trans     &mo 2      &trans
            >;
        };
        lower_layer {
            bindings = <
&trans  &kp BANG  &kp ATSN   &kp HASH  &kp DLLR  &kp PRCT    &kp CRRT   &kp AMPS      &kp KMLT  &kp LPRN  &kp RPRN   &trans
&trans  &kp HASH  &kp QMARK  &kp FSLH  &kp COLN  &kp SCLN    &kp MINUS  &kp KP_EQUAL  &kp LBRC  &kp RBRC  &kp BKSP   &trans
&trans  &kp LSFT  &kp KPLS   &kp LBKT  &kp RBKT  &kp BSLH    &kp UNDER  &kp LEFT      &kp DOWN  &kp UP    &kp RIGHT  &trans
                             &kp RSFT  &mo 1     &kp LCTL    &kp SPC    &mo 2         &kp RSFT
            >;
        };
    };
};
